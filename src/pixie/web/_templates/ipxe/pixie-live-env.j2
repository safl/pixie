#!ipxe
# pixie plan for {{ mac }} - boot_mode={{ boot_mode }}
#
# Boot pixie's own live env. The netboot-pc bake produced vmlinuz +
# initrd + squashfs artifacts; the pixie deploy staged them under
# ``$PIXIE_LIVE_ENV_DIR`` and this HTTP process exposes them at
# ``/boot/pixie-live-env/``. The initrd is a dracut initramfs
# (dmsquash-live + livenet + network); the cmdline shape is:
#
#   root=live:<squashfs URL> rd.live.image ip=dhcp rd.neednet=1
#
# livenet fetches the squashfs over HTTP, dmsquash-live loop-mounts
# it read-only under a tmpfs overlay, and the boot pivots into it.
# ``pixie.server`` + ``pixie.mac`` are the two knobs
# pixie-on-tty1.service reads on every live-env boot; the pixie CLI
# then GETs ``<server>/pxe/<mac>/plan`` and dispatches (auto-flash,
# inventory + reboot, interactive wizard, or exit).
#
# WHY dracut (was Debian live-boot + ``fetch=``): live-boot's
# initramfs network bring-up hung on some hardware (a dual-NIC Intel
# igb box never fetched its squashfs; the SAME box nbdboots fine
# under dracut in ~24s). dracut's network stack works where
# live-boot's did not, and it is the exact path the nbdboot template
# already uses. See CHANGELOG 0.4.x + the dracut drop-in at
# ``config/includes.chroot/etc/dracut.conf.d/10-pixie-live-env.conf``.

set pixie-base http://{{ host }}:{{ port }}

# Cmdline notes:
#
# - ``root=live:<url> rd.live.image``: the dracut dmsquash-live +
#   livenet source. A ``root=live:`` value that is a URL routes
#   dmsquash-live through livenet, which downloads the squashfs and
#   hands it back to dmsquash-live to loop-mount. This replaces
#   live-boot's old ``fetch=<url>`` handler shape.
# - ``ip=dhcp rd.neednet=1``: dracut's ``network`` module needs an
#   explicit DHCP directive AND ``rd.neednet=1`` to bring the primary
#   NIC up in the initramfs before livenet reaches out for the
#   squashfs. (This is the OPPOSITE of the old live-boot advice, which
#   wanted ``ip=dhcp`` REMOVED to avoid live-boot racing its own DHCP
#   client -- that race, and the note about it, no longer apply under
#   dracut, which owns the single DHCP bring-up.) Mirrors the nbdboot
#   template, which is the proven-working dracut cmdline on this
#   hardware.
# - ``plymouth.enable=0 modprobe.blacklist=nouveau,rndis_host
#   nouveau.modeset=0 systemd.gpt_auto=0``: plymouth stays off so the
#   operator sees the full boot stream (a wedge between two ``[ OK ]
#   Started X`` lines is immediately diagnostic); nouveau blacklist
#   keeps NVIDIA GPU quirks from stalling non-graphics targets;
#   rndis_host blacklist stops the kernel from claiming a USB-console-
#   emulated NIC before the real one appears; systemd.gpt_auto=0 keeps
#   systemd from auto-mounting random GPT partitions the flasher is
#   about to overwrite.
#
# ``console=`` chain: LAST-wins for /dev/console. The ttyS0 tail lands
# on most bench-side USB-serial adapters; operators driving from a
# BMC's SoL on ttyS1 append their own ``console=ttyS1,115200`` via
# PIXIE_LIVE_ENV_EXTRA_CMDLINE.

kernel ${pixie-base}/boot/pixie-live-env/vmlinuz root=live:${pixie-base}/boot/pixie-live-env/live.squashfs rd.live.image ip=dhcp rd.neednet=1 console=tty0 console=ttyS1,115200 console=ttyS0,115200 earlyprintk=ttyS0,115200 plymouth.enable=0 modprobe.blacklist=nouveau,rndis_host nouveau.modeset=0 systemd.gpt_auto=0 pixie.server=${pixie-base} pixie.mac={{ mac }} bty.server=${pixie-base} bty.mac={{ mac }}{% if extra_cmdline %} {{ extra_cmdline }}{% endif %}
initrd ${pixie-base}/boot/pixie-live-env/initrd
boot
