#!/bin/sh
# auto/config - live-build configuration for the pixie live env.
#
# live-build invokes this script when (re)configuring the build dir
# (typically the first ``lb build`` run, and again whenever ``lb build``
# itself calls ``lb config``). Encodes our lb config args: Debian
# trixie, no debian-installer, no memtest, no apt recommends, no
# security. Architecture + binary-image-shape + bootloader options
# are derived from the ``PIXIE_VARIANT`` environment variable.
#
# Variants:
#
#   - ``netboot-pc`` (default): amd64 kernel + initrd + squashfs
#     trio for the PXE flow. Server hosts these three files over
#     HTTP and clients chain into them via iPXE.
#   - ``usbboot-pc``: amd64 hybrid ISO image bootable from CD or USB
#     (BIOS + UEFI). Adds ``--bootloaders syslinux,grub-efi`` for
#     dual-firmware boot. No ``pixie.*`` cmdline params: USB-local
#     boot has no pixie-server URL or self-MAC to pin, and
#     ``pixie-on-tty1.service`` fires unconditionally
#     (v0.22.10+ retired the ConditionKernelCommandLine gating).
# The arm64 ``usbboot-rpi`` flasher is NOT a live-build variant. It
# customizes Raspberry Pi OS Lite in place (loop-mount + chroot; see
# ``cijoe/scripts/rpios_image_build.py``) so it never reaches this
# config -- RPiOS already ships every Pi kernel + dtb + firmware,
# which a live image cannot supply cleanly across the split per-SoC
# vendor kernels. live-build here builds only the amd64 x86 variants.
#
# Both x86 variants share the same chroot package set + hooks; the
# amd64 kernel + microcode + r8125 DKMS build env live in the
# generated ``pixie-arch.list.chroot``.
#
# ``lb build`` re-runs this script during its internal ``lb config``
# step, so ``PIXIE_VARIANT`` must be set in the build invocation's
# environment, not just at the initial config call (sudo strips env
# by default; ``cijoe/scripts/usb_iso_build.py`` uses
# ``sudo env PIXIE_VARIANT=...``).
#
# Requires live-build 20240208+ (Debian trixie or newer) which
# fetches ``dists/<release>/main/Contents-<arch>.gz`` from the
# per-component layout Debian now publishes. Ubuntu's stock
# live-build 20230502 still uses the obsolete top-level URL and
# 404s on every active Debian release; ci-cd.yml's media build jobs
# pull the trixie .deb explicitly to work around that.
set -e

# Plymouth was retired in v0.22.1: the kernel-stage graphical splash
# wedged plymouth-quit-wait on several Intel iGPUs (MS-01, EPYC
# bring-up box) and the mascot-splash value didn't justify the
# multi-layer workaround stack (cmdline disable + package purge +
# variant split). The live env now boots to plain kernel + systemd
# init messages; ``/etc/issue`` (rendered by agetty on tty1) carries
# the pixie identity. ``plymouth.enable=0`` stays on the cmdline as
# belt-and-braces in case plymouth ever gets pulled in transitively
# by a future package change: with no package installed it's a
# no-op.

# Transparency: NO ``quiet``, NO ``splash``. pixie wants the full
# kernel + systemd boot stream visible on tty1/serial; a wedge
# between ``[ OK ] Started X`` and ``[ OK ] Started Y`` is
# immediately diagnostic. Same reason plymouth was retired (v0.22.1):
# hiding init output makes operator debugging harder, polish is not
# worth the opacity.

PIXIE_VARIANT="${PIXIE_VARIANT:-netboot-pc}"

case "${PIXIE_VARIANT}" in
    netboot-pc)
        ARCH=amd64
        BINARY_IMAGES=netboot
        BOOTLOADERS_OPTS=""
        ISOVOLUME_OPTS=""
        # netboot clients NEVER boot from this baked appendix: the
        # server's ``ipxe/pixie-live-env.j2`` template renders the FULL
        # kernel cmdline per-client, carrying the dracut live-fetch
        # source + network flags (``root=live:<url> rd.live.image
        # ip=dhcp rd.neednet=1``) and the per-machine ``pixie.server=``
        # / ``pixie.mac=`` knobs. So this baked BOOTAPPEND holds only
        # the shared, non-boot-method tokens; the ``netboot`` binary
        # image doesn't ship a bootloader menu that would consume them
        # anyway. Kept here for parity with usbboot + as the source of
        # truth for the shared tokens the server template also emits.
        # ``modprobe.blacklist=...``: nouveau for iGPU wedges,
        # rndis_host for Aspeed BMC USB Virtual NICs.
        BOOTAPPEND="plymouth.enable=0 modprobe.blacklist=nouveau,rndis_host nouveau.modeset=0 systemd.gpt_auto=0 pixie.version=__PIXIE_VERSION__"
        ;;
    usbboot-pc)
        ARCH=amd64
        BINARY_IMAGES=iso-hybrid
        BOOTLOADERS_OPTS="--bootloaders syslinux,grub-efi"
        # Pin the ISO9660 volume label so the dracut ``root=live:LABEL=``
        # discriminator below has a deterministic target. Without this,
        # live-build stamps its own default volume id, which we'd have to
        # guess in the cmdline. ``PIXIE_LIVE`` is a valid ISO9660 d-name
        # (A-Z0-9_, <=32 chars) and survives usb_iso_build.py's
        # repartition untouched (that step keeps the ISO9660 partition's
        # bytes -- and thus its PVD volume id -- verbatim; it only
        # rewrites the MBR and appends the exFAT PIXIE_IMGS data
        # partition, whose separate label blkid reports independently).
        ISOVOLUME_OPTS="--iso-volume PIXIE_LIVE"
        # dracut migration: the shared initrd is now dracut (see the
        # ``--initramfs dracut-live`` note on the lb config call), so the
        # old live-boot ``boot=live components`` shape no longer boots
        # the USB squashfs. dracut's dmsquash-live finds the local
        # squashfs via ``root=live:LABEL=<vol>``:
        #   * ``LABEL=PIXIE_LIVE`` -- the ISO9660 volume pinned above,
        #     NOT the exFAT PIXIE_IMGS data partition (that one holds
        #     pre-built images, not the rootfs squashfs).
        #   * ``rd.live.dir=live rd.live.squashimg=filesystem.squashfs``
        #     -- live-build lays the rootfs down at
        #     ``/live/filesystem.squashfs`` on the ISO; these two spell
        #     that path out so dmsquash-live doesn't fall back to its
        #     upstream Fedora default (``/LiveOS/squashfs.img``), which
        #     would not exist here.
        # ``console=tty0 console=ttyS0,115200``: kernel + systemd boot
        # messages go to BOTH the framebuffer (tty0, for real hardware
        # operators) and the serial port (ttyS0, for QEMU/IP-KVM/anything
        # capturing the serial). The LAST ``console=`` is the systemd
        # default-stdout sink; we list ttyS0 last so the auto-grow test
        # sees ``[ OK ] Started pixie-usb-grow.service`` on its captured
        # serial log. Harmless on real USB sticks without a serial port:
        # writes are dropped.
        # ``modprobe.blacklist=nouveau,rndis_host`` keeps the USB-boot
        # path's behavior identical to the PXE chain: nouveau for iGPU
        # wedges, rndis_host so Supermicro / Aspeed BMC USB Virtual NICs
        # don't get claimed and confuse NIC autoselect.
        BOOTAPPEND="root=live:LABEL=PIXIE_LIVE rd.live.image rd.live.dir=live rd.live.squashimg=filesystem.squashfs noeject plymouth.enable=0 modprobe.blacklist=nouveau,rndis_host nouveau.modeset=0 systemd.gpt_auto=0 console=tty0 console=ttyS0,115200 pixie.version=__PIXIE_VERSION__"
        ;;
    *)
        echo "auto/config: unknown PIXIE_VARIANT=${PIXIE_VARIANT}" >&2
        echo "  valid: netboot-pc | usbboot-pc" >&2
        exit 2
        ;;
esac

# Per-architecture package list, written here rather than in a
# ``.list.chroot_<arch>``-suffixed file under ``config/package-lists/``
# because Debian live-build 3.0~a57 (Ubuntu trixie/jammy runners) does
# NOT consume the underscore-suffix form; the docs imply it should
# but the runner build that ships with the GHA image does not. To
# avoid version-specific guesswork, generate a plain
# ``pixie-arch.list.chroot`` based on the resolved ``${ARCH}``. live-
# build always consumes unsuffixed ``*.list.chroot`` files.
mkdir -p config/package-lists
case "${ARCH}" in
    amd64)
        # amd64 kernel + Intel/AMD microcode + r8125 DKMS build env.
        # Why microcode: PXE-booted bare metal has no host-loaded
        # ucode, and modern Ryzen + recent Intel cores ship factory
        # microcode missing Spectre/SRBDS/Reptar/Inception mitigations.
        # Pinned to trixie-backports via
        # ``config/preferences/backports.pref.chroot``.
        # ``dracut-live`` + ``dracut-network`` back the live-env's
        # dracut initrd (``--initramfs dracut-live`` on the lb config
        # call): dracut-live ships the dmsquash-live + livenet modules
        # (fetch + loop-mount the squashfs), dracut-network the network
        # module (initramfs NIC bring-up via DHCP). live-build installs
        # dracut-live itself for ``--initramfs dracut-live``, but we name
        # both explicitly so the network module can't be trimmed and the
        # dependency is visible here. This is the migration off Debian
        # live-boot, whose ``fetch=`` initramfs NIC bring-up hung on some
        # hardware; ``live-boot`` is correspondingly dropped from
        # ``pixie-base.list.chroot``.
        cat >config/package-lists/pixie-arch.list.chroot <<'PKGS'
linux-image-amd64
intel-microcode
amd64-microcode
dkms
build-essential
linux-headers-amd64
dracut-live
dracut-network
PKGS
        ;;
    *)
        echo "auto/config: no per-arch package list for ARCH=${ARCH}" >&2
        exit 2
        ;;
esac

# ``--initramfs dracut-live``: build the live-env initrd with dracut
# (dmsquash-live + livenet + network) instead of Debian live-boot +
# initramfs-tools. Motivation: live-boot's ``fetch=`` initramfs network
# bring-up hung on some hardware (a dual-NIC Intel igb box never fetched
# its squashfs; the same box nbdboots fine under dracut). dracut's
# network stack works where live-boot's did not, and it's the path
# nbdboot already uses. The initrd is configured by
# ``config/includes.chroot/etc/dracut.conf.d/10-pixie-live-env.conf``
# (hostonly=no + forced dmsquash-live/livenet/network modules); the
# per-variant ``root=live:...`` source is on the BOOTAPPEND above
# (usbboot, LABEL-based) or rendered by the server's
# ``ipxe/pixie-live-env.j2`` (netboot, URL-based).
# shellcheck disable=SC2086 # BOOTLOADERS_OPTS / ISOVOLUME_OPTS are intentionally word-split
lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures "${ARCH}" \
    --archive-areas "main non-free-firmware" \
    --firmware-chroot true \
    --binary-images "${BINARY_IMAGES}" \
    --initramfs dracut-live \
    --debian-installer none \
    --memtest none \
    --apt-recommends false \
    --security false \
    ${BOOTLOADERS_OPTS} \
    ${ISOVOLUME_OPTS} \
    --bootappend-live "${BOOTAPPEND}" \
    "${@}"
# ``--archive-areas "main non-free-firmware"`` unlocks the
# ``firmware-*`` packages. Default areas are just ``main``, which
# silently drops every firmware blob and produces a live env where
# i915 wedges the GPU on probe and certain NIC / WiFi chipsets fail
# to load. Debian split ``non-free-firmware`` out of ``non-free``
# in bookworm precisely so this archive can be enabled on its own.
#
# ``--firmware-chroot true`` pulls ``firmware-linux-nonfree`` (a
# metapackage that Depends on EVERY individual nonfree ``firmware-*``
# package: realtek, iwlwifi, atheros, brcm80211, mediatek, ath11k,
# bnx2/bnx2x, netronome, nvidia-graphics, amd-graphics, and a long
# tail of server-NIC + old-WiFi blobs). The size cost (~300 MiB
# compressed) buys "boots on whatever bare-metal box the operator
# points it at"; the alternative is the operator hits a missing
# firmware -> driver init failure -> dead NIC and can't proceed.
# A curated list is too narrow: Realtek WiFi/BT chipsets alone
# span half a dozen firmware packages and consumer mini-PCs cycle
# them quickly.
# The trixie-backports archive layered via
# ``config/archives/backports.list.chroot`` plus the pin in
# ``config/preferences/backports.pref.chroot`` makes apt pull the
# newest kernel + firmware Debian ships, not just trixie's.
# Bootloader-menu suppression: see
# ``hooks/binary/0500-pixie-skip-bootloader-menu.hook.binary``. Don't
# add ``--syslinux-timeout`` here; live-build trixie doesn't
# recognise that flag and ``lb config`` errors out.
